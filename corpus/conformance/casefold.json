{"bindings":null,"version":"1.0.0","grammar":"ConformanceCasefold","shape":"parsanol-tree/v2","binding_version":1,"entries":{"main":{"root":"main","grammar":{"atoms":[{"Re":{"pattern":"(?i:select)"}},{"Str":{"pattern":" "}},{"Re":{"pattern":"[\\x30-\\x39]"}},{"Repetition":{"atom":2,"min":1,"max":null,"tag":"Repetition"}},{"Named":{"name":"number","atom":3}},{"Sequence":{"atoms":[0,1,4]}}],"root":5},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"main","render":{},"derive":{},"tests":[{"entry":"main","kind":"accept","input":"select 42","expect":{}},{"entry":"main","kind":"accept","input":"SELECT 42","expect":{}},{"entry":"main","kind":"accept","input":"Select 42","expect":{}},{"entry":"main","kind":"reject","input":"selection 42","expect":{}},{"entry":"main","kind":"capture","input":"SELECT 7","expect":{"number":"7"}}],"docs":{"main":"Case-insensitive keyword followed by a number."},"source":"## Semantics: T2, T1, C1, C3, K1, A1, A2, M0\ngrammar ConformanceCasefold version \"1.0.0\" edition \"v2\" {\n  ## Case-insensitive keyword followed by a number.\n  main = %i\"select\" \" \" ( 1*%x30-39 as number )\n\n  entry main: main\n\n  test {\n    accept \"select 42\"\n    accept \"SELECT 42\"\n    accept \"Select 42\"\n    reject \"selection 42\"\n    capture \"SELECT 7\" { number: \"7\" }\n  }\n}\n","source_hash":"023d1adf4c3559511cbb6828b895aa1843ea2d17677a86a33ad00466c9db59f4","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.126","edition":2,"semantics_hash":"sha256:91e53c259006c622a043e4a169fbb329ddaef433eda3612620e507bba6a6f9d8","checksum":"sha256:0a31ece1ed0f132f971cda7e7d4403c438181dbaa02ee61f8498992ace65fac4"}
