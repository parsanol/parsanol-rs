{"bindings":null,"version":"1.0.0","grammar":"ConformanceCasefold","shape":"parsanol-tree/v2","binding_version":1,"entries":{"main":{"root":"main","grammar":{"atoms":[{"Re":{"pattern":"(?i:select)"}},{"Str":{"pattern":" "}},{"Re":{"pattern":"[\\x30-\\x39]"}},{"Repetition":{"atom":2,"min":1,"max":null,"tag":"Repetition"}},{"Named":{"name":"number","atom":3}},{"Sequence":{"atoms":[0,1,4]}}],"root":5},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"main","render":{},"derive":{},"tests":[{"entry":"main","kind":"accept","input":"select 42","expect":{}},{"entry":"main","kind":"accept","input":"SELECT 42","expect":{}},{"entry":"main","kind":"accept","input":"Select 42","expect":{}},{"entry":"main","kind":"reject","input":"selection 42","expect":{}},{"entry":"main","kind":"capture","input":"SELECT 7","expect":{"number":"7"}}],"docs":{"main":"Case-insensitive keyword followed by a number."},"source":"## Semantics: T2, T1, C1, C3, K1, A1, A2, M0\ngrammar ConformanceCasefold version \"1.0.0\" edition \"v1\" {\n  ## Case-insensitive keyword followed by a number.\n  main = %i\"select\" \" \" ( 1*%x30-39 as number )\n\n  entry main: main\n\n  test {\n    accept \"select 42\"\n    accept \"SELECT 42\"\n    accept \"Select 42\"\n    reject \"selection 42\"\n    capture \"SELECT 7\" { number: \"7\" }\n  }\n}\n","source_hash":"3f466fa8eacd2f8626b9a1133dfd08ccd97872332e2afa1c33078b17c4f1289f","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.117","edition":1,"semantics_hash":"sha256:f45bfbc39e0f5720612f97c7f3089c8fd34f86c6df3d6acd321bd1c0a84ba9b3","checksum":"sha256:40a439c7e281050d5a2d4ca4fad84a48e2110b06e2806737ee1f7f572b5e45a8"}
