## Semantics: V3, C3, K1, A1, A2, M0
grammar ConformanceRepeatFlatten version "1.0.0" edition "v1" {
  ## Mixed repetition: hash iterations survive, bare text is dropped;
  ## an all-text repetition concatenates instead.
  main = 1*( ( 1*%x61-7A ) as word / ";" )

  entry main: main

  test main {
    shape "ab;cd" [ { word: "ab" }, { word: "cd" } ]
    shape "ab;" [ { word: "ab" } ]
    shape ";;" ";;"
    reject "ab!"
  }
}
