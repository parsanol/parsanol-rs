## Semantics: T1, T3, C1, C7, K1, V1, V2, A1, A2, M0
grammar ConformanceAtoms version "1.0.0" edition "v1" {
  ## A word, separator, number - the lexical baseline.
  main = (1*%x61-7A as text) " " (1*%x30-39 as digits)

  entry main: main

  test main {
    accept "abc 42"
    reject "abc"
    reject "ABC 42"
    capture "ab 42" { text: "ab"
      digits: "42" }
  }
}
