## Semantics: E2 (recovery — the R1.5 partial-tree differential input)
grammar RecoveryKV version "1.0.0" edition "v1" {
  ## key = value ; pairs
  pair = ( 1*( %x61-7A / %x30-39 ) ) as k "=" ( 1*( %x30-39 ) ) as v ";"
  document = 1*( pair )
  entry main: document

  test main {
    accept "a=1;b=2;"
    reject "a=1;b=2;c=3"
  }
}
