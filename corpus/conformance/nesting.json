  "source": "grammar ConformanceNesting version \"1.0.0\" {\n  ## A name segment: letters/digits.\n  segment = 1*( %x61-7A / %x30-39 )\n  ## A path: segments joined by dots, captured.\n  path = ( segment *( \".\" segment ) ) as path\n  ## A list: comma-separated paths.\n  main = path *( \",\" \" \" path )\n\n  bindings main {\n    path -> path\n  }\n\n  entry main: main\n\n  test main {\n    example \"a.b\" { path: \"a.b\" }\n    accept \"a.b, c1d2, e3\"\n    reject \"a..b\"\n  }\n}\n",
