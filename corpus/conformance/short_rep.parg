## Semantics: T3, C3, K1, V3, B3, A1, A2, M0
grammar ConformanceShortRep version "1.0.0" mode "v1" {
  ## One to three letters, captured.
  short = 1*3(%x61-7A) as code

  entry short: short

  test short {
    capture "ab" { code: "ab" }
    capture "abc" { code: "abc" }
    reject "abcd"
    reject ""
  }
}
