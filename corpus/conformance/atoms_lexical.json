  "source": "grammar ConformanceAtoms version \"1.0.0\" {\n  ## A word, separator, number - the lexical baseline.\n  main = (1*%x61-7A as text) \" \" (1*%x30-39 as digits)\n\n  bindings main {\n    text -> text\n    digits -> digits\n  }\n\n  entry main: main\n\n  test main {\n    accept \"abc 42\"\n    reject \"abc\"\n    reject \"ABC 42\"\n    example \"ab 42\" { text: \"ab\"\n      digits: \"42\" }\n  }\n}\n",
