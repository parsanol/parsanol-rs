{"bindings":null,"version":"1.0.0","grammar":"ConformanceAtoms","shape":"parsanol-tree/v2","binding_version":1,"entries":{"main":{"root":"main","grammar":{"atoms":[{"Re":{"pattern":"[\\x61-\\x7a]"}},{"Repetition":{"atom":0,"min":1,"max":null,"tag":"Repetition"}},{"Named":{"name":"text","atom":1}},{"Str":{"pattern":" "}},{"Re":{"pattern":"[\\x30-\\x39]"}},{"Repetition":{"atom":4,"min":1,"max":null,"tag":"Repetition"}},{"Named":{"name":"digits","atom":5}},{"Sequence":{"atoms":[2,3,6]}}],"root":7},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"main","render":{},"derive":{},"tests":[{"entry":"main","kind":"accept","input":"abc 42","expect":{}},{"entry":"main","kind":"reject","input":"abc","expect":{}},{"entry":"main","kind":"reject","input":"ABC 42","expect":{}},{"entry":"main","kind":"capture","input":"ab 42","expect":{"text":"ab","digits":"42"}}],"docs":{"main":"A word, separator, number - the lexical baseline."},"source":"## Semantics: T1, T3, C1, C7, K1, V1, V2, A1, A2, M0\ngrammar ConformanceAtoms version \"1.0.0\" {\n  ## A word, separator, number - the lexical baseline.\n  main = (1*%x61-7A as text) \" \" (1*%x30-39 as digits)\n\n  entry main: main\n\n  test main {\n    accept \"abc 42\"\n    reject \"abc\"\n    reject \"ABC 42\"\n    capture \"ab 42\" { text: \"ab\"\n      digits: \"42\" }\n  }\n}\n","source_hash":"64fa9a959fc7b2c01abea61ed04b011ee001a59d23f8e9de4eab028517b8ffed","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.109","checksum":"sha256:2166ee52d17121c48ad2328e8425830f025cb4e3d670ae9d3371bb60dc2963c8"}
