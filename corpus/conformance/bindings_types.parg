## Semantics: C3, K1, K2, B1, B2, B3, A1, A3, M0
grammar ConformanceTypes version "1.0.0" mode "v1" {
  ## A year: four digits, cast to integer.
  main = 4*( %x30-39 ) as year

  bindings main {
    year -> year (integer)
  }

  entry main: main

  test main {
    example "2020" { year: 2020 }
    reject "20a0"
    reject "123"
  }
}
