## Semantics: T3, C5, C6, K1, V3, M0, A1, A2
grammar ConformanceLookbehind version "1.0.0" edition "v1" {
  ## Emphasis: a star not preceded by a letter, content, star.
  emph = ( !< %x61-7A "*" 1*( !"*" ANY ) "*" ) as emph
  ## Words and emphasis.
  main = 1*( emph / ( !"*" ANY ) )

  entry main: main

  test main {
    capture "*cool*" { emph: "*cool*" }
    reject "a*b*"
  }
}
