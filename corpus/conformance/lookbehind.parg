grammar ConformanceLookbehind version "1.0.0" {
  ## Emphasis: a star not preceded by a letter, content, star.
  emph = ( !< %x61-7A "*" 1*( !"*" ANY ) "*" ) as emph
  ## Words and emphasis.
  main = 1*( emph / ( !"*" ANY ) )

  entry main: main

  test main {
    capture "*cool*" { emph: "*cool*" }
    reject "a*b*"
  }
}
