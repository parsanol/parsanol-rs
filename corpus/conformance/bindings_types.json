{"bindings":null,"version":"1.0.0","grammar":"ConformanceTypes","shape":"parsanol-tree/v2","binding_version":1,"entries":{"main":{"root":"main","grammar":{"atoms":[{"Re":{"pattern":"[\\x30-\\x39]"}},{"Repetition":{"atom":0,"min":4,"max":null,"tag":"Repetition"}},{"Named":{"name":"year","atom":1}}],"root":2},"bindings":[{"capture":"year","path":"year","type":"integer","card":null,"preprocess":null}]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"main","render":{},"derive":{},"tests":[{"entry":"main","kind":"example","input":"2020","expect":{"year":2020}},{"entry":"main","kind":"reject","input":"20a0","expect":{}},{"entry":"main","kind":"reject","input":"123","expect":{}}],"docs":{"main":"A year: four digits, cast to integer."},"source":"## Semantics: C3, K1, K2, B1, B2, B3, A1, A3, M0\ngrammar ConformanceTypes version \"1.0.0\" mode \"v1\" {\n  ## A year: four digits, cast to integer.\n  main = 4*( %x30-39 ) as year\n\n  bindings main {\n    year -> year (integer)\n  }\n\n  entry main: main\n\n  test main {\n    example \"2020\" { year: 2020 }\n    reject \"20a0\"\n    reject \"123\"\n  }\n}\n","source_hash":"6977f19c94d955908d860e0fc15ddb3d029fb56d56588a5684ff4d88a62114a9","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.110","mode":"v1","emission":2,"checksum":"sha256:1d36afb25e125460a987c2db4fea870cf3622b6c5107ec2b3926c09f3dd92411"}
