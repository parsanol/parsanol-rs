{"bindings":null,"version":"1.0.0","grammar":"ConformanceOptionalCapture","shape":"parsanol-tree/v2","binding_version":1,"entries":{"main":{"root":"main","grammar":{"atoms":[{"Str":{"pattern":"-"}},{"Repetition":{"atom":0,"min":0,"max":1,"tag":"Maybe"}},{"Named":{"name":"dash","atom":1}},{"Re":{"pattern":"[\\x61-\\x7a]"}},{"Repetition":{"atom":3,"min":1,"max":null,"tag":"Repetition"}},{"Sequence":{"atoms":[2,4]}}],"root":5},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"main","render":{},"derive":{},"tests":[{"entry":"main","kind":"capture","input":"-ab","expect":{"dash":"-"}},{"entry":"main","kind":"capture","input":"ab","expect":{"dash":null}},{"entry":"main","kind":"accept","input":"ab","expect":{}},{"entry":"main","kind":"reject","input":"-","expect":{}}],"docs":{"main":"An optional dash prefix captured as a whole: nil when absent."},"source":"## Semantics: C4, K1, K2, V2, M0, A1, A2\ngrammar ConformanceOptionalCapture version \"1.0.0\" mode \"classic\" {\n  ## An optional dash prefix captured as a whole: nil when absent.\n  main = ( [ \"-\" ] ) as dash 1*%x61-7A\n\n  entry main: main\n\n  test main {\n    capture \"-ab\" { dash: \"-\" }\n    capture \"ab\" { dash: null }\n    accept \"ab\"\n    reject \"-\"\n  }\n}\n","source_hash":"a6a97ee4c35a8b9192a786ec5e43ab8723e85d01a7b9c01dc890f85bcad0e695","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.109","mode":"classic","checksum":"sha256:c1f83573923dbce154b8f797f5dcac426df65d9db21589c65897b0be596ee87d"}
