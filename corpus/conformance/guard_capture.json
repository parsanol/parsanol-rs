{"bindings":null,"version":"1.0.0","grammar":"GuardCapture","shape":"parsanol-tree/v2","binding_version":1,"entries":{"year":{"root":"year","grammar":{"atoms":[{"Entity":{"atom":1}},{"Str":{"pattern":":"}},{"Named":{"name":"colon","atom":0}},{"Entity":{"atom":6}},{"Str":{"pattern":"AMD"}},{"Str":{"pattern":"COR"}},{"Alternative":{"atoms":[4,5]}},{"Named":{"name":"word","atom":3}},{"Entity":{"atom":1}},{"Named":{"name":"colon","atom":8}},{"Str":{"pattern":"19"}},{"Str":{"pattern":"20"}},{"Alternative":{"atoms":[10,11]}},{"Entity":{"atom":14}},{"Re":{"pattern":"[\\x30-\\x39]"}},{"Repetition":{"atom":13,"min":2,"max":null,"tag":"Repetition"}},{"Entity":{"atom":14}},{"Lookahead":{"atom":16,"positive":false}},{"Named":{"name":"year","atom":17}},{"Sequence":{"atoms":[9,12,15,18]}},{"Repetition":{"atom":19,"min":0,"max":1,"tag":"Maybe"}},{"Sequence":{"atoms":[2,7,20]}}],"root":21},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"year","render":{},"derive":{},"tests":[{"entry":"year","kind":"accept","input":":AMD:1999","expect":{}},{"entry":"year","kind":"reject","input":"nonsense","expect":{}}],"docs":{},"source":"# Semantics: capture postfix binds the GUARD (parsanol-ruby#380) —\n# `!digit as year` is `( !digit ) as year`, never `!(digit as year)`.\ngrammar GuardCapture version \"1.0.0\" {\n  digit = %x30-39\n  colon = \":\"\n  word = \"AMD\" / \"COR\"\n  year = ( colon ) ( word ) [ colon ( \"19\" / \"20\" ) 2*digit !digit as year ]\n  entry year: year\n  test {\n    accept \":AMD:1999\"\n    reject \"nonsense\"\n  }\n}\n","source_hash":"3ad0c9d19d2ac270a5b64776bdc341fc6eefd183ae096b814715c629c793e33b","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.126","edition":2,"semantics_hash":"sha256:56fac690db128a617a6cac0e09370356b906dd7efb72ba2a3a538e95033b5bdd","checksum":"sha256:ef8ef228f35ca7ae2b13af0e7d4bcad965c1d7455bcdea6e5c49c4c250cb6f3d"}
