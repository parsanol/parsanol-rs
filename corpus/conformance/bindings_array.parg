## Semantics: B1, B2, B3, B4, C3, K1, A1, A3, M0
grammar ConformanceBindingsArray version "1.0.0" {
  ## Comma-separated integers bound as an array of objects.
  item = 1*%x30-39 as n
  main = item *( "," item )

  bindings main {
    n -> items[].n (integer)
  }

  entry main: main

  test main {
    example "1,2" { items: [ { n: 1 }, { n: 2 } ] }
    example "7" { items: [ { n: 7 } ] }
    reject "1,"
  }
}
