## Semantics: S1, S2, S3, S4, S5, T1, T3, C1, C7, K1, B1, A1, A2, M0
grammar ConformanceSkip version "1.0.0" edition "v1" {
  ## Whitespace between tokens.
  trivia = 1*" "
  ## A key = value pair; trivia rides between tokens.
  main = ( 1*%x61-7A as key ) "=" ( 1*%x30-39 as value )

  skip = trivia

  entry main: main

  test main {
    accept "abc=42"
    accept "  abc = 42"
    capture "abc=42" { key: "abc"
      value: "42" }
    reject "abc = "
  }
}
