grammar ConformanceRepetition version "1.0.0" {
  ## Exactly two letters, captured as one string.
  pair = 2*2(%x61-7A) as code
  ## An optional dash prefix, then the pair.
  dashed = [ "-" as dash ] pair

  bindings dashed {
    dash -> dash
    code -> code (string)
  }

  entry dashed: dashed

  test dashed {
    accept "-ab"
    example "-ab" { dash: "-"
      code: "ab" }
    example "ab" { code: "ab" }
    reject "-a"
    reject "abc"
  }
}
