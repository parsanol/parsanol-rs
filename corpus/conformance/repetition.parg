grammar ConformanceRepetition version "1.0.0" {
  ## Exactly two letters, captured as one string.
  pair = 2*2(%x61-7A) as code
  ## An optional dash prefix, then the pair.
  dashed = [ "-" as dash ] pair

  entry dashed: dashed

  test dashed {
    accept "-ab"
    capture "-ab" { dash: "-"
      code: "ab" }
    capture "ab" { code: "ab" }
    reject "-a"
    reject "abc"
  }
}
