## Semantics: C4, K1, K2, V2, M0, A1, A2
grammar ConformanceOptionalCapture version "1.0.0" {
  ## An optional dash prefix captured as a whole: nil when absent.
  main = ( [ "-" ] ) as dash 1*%x61-7A

  entry main: main

  test main {
    capture "-ab" { dash: "-" }
    capture "ab" { dash: null }
    accept "ab"
    reject "-"
  }
}
