{"bindings":null,"version":"1.0.0","grammar":"ConformanceEntries","shape":"parsanol-tree/v2","binding_version":1,"entries":{"word":{"root":"word","grammar":{"atoms":[{"Re":{"pattern":"[\\x61-\\x7a]"}},{"Repetition":{"atom":0,"min":1,"max":null,"tag":"Repetition"}},{"Named":{"name":"word","atom":1}}],"root":2},"bindings":[]},"num":{"root":"num","grammar":{"atoms":[{"Re":{"pattern":"[\\x30-\\x39]"}},{"Repetition":{"atom":0,"min":1,"max":null,"tag":"Repetition"}},{"Named":{"name":"num","atom":1}}],"root":2},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":null,"render":{},"derive":{},"tests":[{"entry":"word","kind":"accept","input":"abc","expect":{}},{"entry":"word","kind":"reject","input":"123","expect":{}},{"entry":"word","kind":"capture","input":"abc","expect":{"word":"abc"}},{"entry":"num","kind":"accept","input":"42","expect":{}},{"entry":"num","kind":"reject","input":"abc","expect":{}},{"entry":"num","kind":"capture","input":"42","expect":{"num":"42"}}],"docs":{"word":"Two entries over one rule set; every test names its entry."},"source":"## Semantics: C7, T3, C3, K1, A1, A2, M0\ngrammar ConformanceEntries version \"1.0.0\" mode \"classic\" {\n  ## Two entries over one rule set; every test names its entry.\n  word = 1*%x61-7A as word\n  num = 1*%x30-39 as num\n\n  entry word: word\n  entry num: num\n\n  test word {\n    accept \"abc\"\n    reject \"123\"\n    capture \"abc\" { word: \"abc\" }\n  }\n\n  test num {\n    accept \"42\"\n    reject \"abc\"\n    capture \"42\" { num: \"42\" }\n  }\n}\n","source_hash":"078ffcc22ed504255c885abd47c288b5f636de9c86e7ef95da903ed0e5561157","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.109","mode":"classic","checksum":"sha256:dc91f8d395f8252599c354357505eeaf9b0b1f054d58e8756f58585d44ca9e00"}
