{"bindings":null,"version":"1.0.0","grammar":"ConformanceEntries","shape":"parsanol-tree/v2","binding_version":1,"entries":{"word":{"root":"word","grammar":{"atoms":[{"Re":{"pattern":"[\\x61-\\x7a]"}},{"Repetition":{"atom":0,"min":1,"max":null,"tag":"Repetition"}},{"Named":{"name":"word","atom":1}}],"root":2},"bindings":[]},"num":{"root":"num","grammar":{"atoms":[{"Re":{"pattern":"[\\x30-\\x39]"}},{"Repetition":{"atom":0,"min":1,"max":null,"tag":"Repetition"}},{"Named":{"name":"num","atom":1}}],"root":2},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":null,"render":{},"derive":{},"tests":[{"entry":"word","kind":"accept","input":"abc","expect":{}},{"entry":"word","kind":"reject","input":"123","expect":{}},{"entry":"word","kind":"capture","input":"abc","expect":{"word":"abc"}},{"entry":"num","kind":"accept","input":"42","expect":{}},{"entry":"num","kind":"reject","input":"abc","expect":{}},{"entry":"num","kind":"capture","input":"42","expect":{"num":"42"}}],"docs":{"word":"Two entries over one rule set; every test names its entry."},"source":"## Semantics: C7, T3, C3, K1, A1, A2, M0\ngrammar ConformanceEntries version \"1.0.0\" edition \"v1\" {\n  ## Two entries over one rule set; every test names its entry.\n  word = 1*%x61-7A as word\n  num = 1*%x30-39 as num\n\n  entry word: word\n  entry num: num\n\n  test word {\n    accept \"abc\"\n    reject \"123\"\n    capture \"abc\" { word: \"abc\" }\n  }\n\n  test num {\n    accept \"42\"\n    reject \"abc\"\n    capture \"42\" { num: \"42\" }\n  }\n}\n","source_hash":"32ebc880f2187288259328ae25d8cd644365dc0592600be38c3f792535ca7556","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.117","edition":1,"semantics_hash":"sha256:bb269421a512547e9e3681bdf447447e27d949cd2f8d77a8d9e0199c44b181e4","checksum":"sha256:cd52df7a344d160bce0d2ade31c3d892b1713ea4879d26bbbb311789faf2fe8c"}
