{"bindings":null,"version":"1.0.0","grammar":"ConformanceEntries","shape":"parsanol-tree/v2","binding_version":1,"entries":{"word":{"root":"word","grammar":{"atoms":[{"Re":{"pattern":"[\\x61-\\x7a]"}},{"Repetition":{"atom":0,"min":1,"max":null,"tag":"Repetition"}},{"Named":{"name":"word","atom":1}}],"root":2},"bindings":[]},"num":{"root":"num","grammar":{"atoms":[{"Re":{"pattern":"[\\x30-\\x39]"}},{"Repetition":{"atom":0,"min":1,"max":null,"tag":"Repetition"}},{"Named":{"name":"num","atom":1}}],"root":2},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":null,"render":{},"derive":{},"tests":[{"entry":"word","kind":"accept","input":"abc","expect":{}},{"entry":"word","kind":"reject","input":"123","expect":{}},{"entry":"word","kind":"capture","input":"abc","expect":{"word":"abc"}},{"entry":"num","kind":"accept","input":"42","expect":{}},{"entry":"num","kind":"reject","input":"abc","expect":{}},{"entry":"num","kind":"capture","input":"42","expect":{"num":"42"}}],"docs":{"word":"Two entries over one rule set; every test names its entry."},"source":"## Semantics: C7, T3, C3, K1, A1, A2, M0\ngrammar ConformanceEntries version \"1.0.0\" {\n  ## Two entries over one rule set; every test names its entry.\n  word = 1*%x61-7A as word\n  num = 1*%x30-39 as num\n\n  entry word: word\n  entry num: num\n\n  test word {\n    accept \"abc\"\n    reject \"123\"\n    capture \"abc\" { word: \"abc\" }\n  }\n\n  test num {\n    accept \"42\"\n    reject \"abc\"\n    capture \"42\" { num: \"42\" }\n  }\n}\n","source_hash":"70ee679e5443c20c9f0ca01f1ed4fbb6973b3b70095beb378f685ee6e2109833","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.109","checksum":"sha256:704dc1fe098416ae3517bd995d51b9b2fc97d258ae54f9d8c7acecd256b1e2b9"}
