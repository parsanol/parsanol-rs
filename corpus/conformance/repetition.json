{"bindings":null,"version":"1.0.0","grammar":"ConformanceRepetition","shape":"parsanol-tree/v2","binding_version":1,"entries":{"dashed":{"root":"dashed","grammar":{"atoms":[{"Str":{"pattern":"-"}},{"Named":{"name":"dash","atom":0}},{"Repetition":{"atom":1,"min":0,"max":1,"tag":"Maybe"}},{"Entity":{"atom":6}},{"Re":{"pattern":"[\\x61-\\x7a]"}},{"Repetition":{"atom":4,"min":2,"max":2,"tag":"Repetition"}},{"Named":{"name":"code","atom":5}},{"Sequence":{"atoms":[2,3]}}],"root":7},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"dashed","render":{},"derive":{},"tests":[{"entry":"dashed","kind":"accept","input":"-ab","expect":{}},{"entry":"dashed","kind":"capture","input":"-ab","expect":{"dash":"-","code":"ab"}},{"entry":"dashed","kind":"capture","input":"ab","expect":{"code":"ab"}},{"entry":"dashed","kind":"reject","input":"-a","expect":{}},{"entry":"dashed","kind":"reject","input":"abc","expect":{}}],"docs":{"pair":"Exactly two letters, captured as one string.","dashed":"An optional dash prefix, then the pair."},"source":"## Semantics: T1, C3, C4, K1, V2, V3, B1, B3, A1, A2, M0\ngrammar ConformanceRepetition version \"1.0.0\" edition \"v1\" {\n  ## Exactly two letters, captured as one string.\n  pair = 2*2(%x61-7A) as code\n  ## An optional dash prefix, then the pair.\n  dashed = [ \"-\" as dash ] pair\n\n  entry dashed: dashed\n\n  test dashed {\n    accept \"-ab\"\n    capture \"-ab\" { dash: \"-\"\n      code: \"ab\" }\n    capture \"ab\" { code: \"ab\" }\n    reject \"-a\"\n    reject \"abc\"\n  }\n}\n","source_hash":"6f162dec8d318d9bd5595bf04e04d7d7453bda2b52c3a4d36651cb1add379d12","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.117","edition":1,"semantics_hash":"sha256:5eb59f6ace7ea09bb2ecf8aba7be54d643da503689731df4c1f617846caa0076","checksum":"sha256:dc950e7aa6bc7e7f80281af0db7e9fc2cfe43edc02775d33f1ad0b4d00562d2c"}
