  "source": "## Semantics: T1, C3, C4, K1, V2, V3, B1, B3, A1, A2, M0\ngrammar ConformanceRepetition version \"1.0.0\" mode \"v1\" {\n  ## Exactly two letters, captured as one string.\n  pair = 2*2(%x61-7A) as code\n  ## An optional dash prefix, then the pair.\n  dashed = [ \"-\" as dash ] pair\n\n  entry dashed: dashed\n\n  test dashed {\n    accept \"-ab\"\n    capture \"-ab\" { dash: \"-\"\n      code: \"ab\" }\n    capture \"ab\" { code: \"ab\" }\n    reject \"-a\"\n    reject \"abc\"\n  }\n}\n",
