  "source": "grammar ConformanceRepetition version \"1.0.0\" {\n  ## Exactly two letters, captured as one string.\n  pair = 2*2(%x61-7A) as code\n  ## An optional dash prefix, then the pair.\n  dashed = [ \"-\" as dash ] pair\n\n  bindings dashed {\n    dash -> dash\n    code -> code (string)\n  }\n\n  entry dashed: dashed\n\n  test dashed {\n    accept \"-ab\"\n    example \"-ab\" { dash: \"-\"\n      code: \"ab\" }\n    example \"ab\" { code: \"ab\" }\n    reject \"-a\"\n    reject \"abc\"\n  }\n}\n",
