{"bindings":null,"version":"1.0.0","grammar":"ConformanceRepetition","shape":"parsanol-tree/v2","binding_version":1,"entries":{"dashed":{"root":"dashed","grammar":{"atoms":[{"Str":{"pattern":"-"}},{"Named":{"name":"dash","atom":0}},{"Repetition":{"atom":1,"min":0,"max":1,"tag":"Maybe"}},{"Entity":{"atom":6}},{"Re":{"pattern":"[\\x61-\\x7a]"}},{"Repetition":{"atom":4,"min":2,"max":2,"tag":"Repetition"}},{"Named":{"name":"code","atom":5}},{"Sequence":{"atoms":[2,3]}}],"root":7},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"dashed","render":{},"derive":{},"tests":[{"entry":"dashed","kind":"accept","input":"-ab","expect":{}},{"entry":"dashed","kind":"capture","input":"-ab","expect":{"dash":"-","code":"ab"}},{"entry":"dashed","kind":"capture","input":"ab","expect":{"code":"ab"}},{"entry":"dashed","kind":"reject","input":"-a","expect":{}},{"entry":"dashed","kind":"reject","input":"abc","expect":{}}],"docs":{"pair":"Exactly two letters, captured as one string.","dashed":"An optional dash prefix, then the pair."},"source":"## Semantics: T1, C3, C4, K1, V2, V3, B1, B3, A1, A2, M0\ngrammar ConformanceRepetition version \"1.0.0\" edition \"v2\" {\n  ## Exactly two letters, captured as one string.\n  pair = 2*2(%x61-7A) as code\n  ## An optional dash prefix, then the pair.\n  dashed = [ \"-\" as dash ] pair\n\n  entry dashed: dashed\n\n  test dashed {\n    accept \"-ab\"\n    capture \"-ab\" { dash: \"-\"\n      code: \"ab\" }\n    capture \"ab\" { code: \"ab\" }\n    reject \"-a\"\n    reject \"abc\"\n  }\n}\n","source_hash":"0b02fe9657ed742c7cec89a55501c9dda51d201e78a9bd27b193c186645f661f","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.126","edition":2,"semantics_hash":"sha256:1611ddcaa071f421ebe67a7094021dc284eeed4ba68b7972a48a10610098f338","checksum":"sha256:681dfcd6893bd307d6bdf7c25c19f28fb1a1b89aaffa18d149bf6ae58522f054"}
