{"bindings":null,"version":"1.0.0","grammar":"ConformanceRepetition","shape":"parsanol-tree/v2","binding_version":1,"entries":{"dashed":{"root":"dashed","grammar":{"atoms":[{"Str":{"pattern":"-"}},{"Named":{"name":"dash","atom":0}},{"Repetition":{"atom":1,"min":0,"max":1,"tag":"Maybe"}},{"Entity":{"atom":6}},{"Re":{"pattern":"[\\x61-\\x7a]"}},{"Repetition":{"atom":4,"min":2,"max":2,"tag":"Repetition"}},{"Named":{"name":"code","atom":5}},{"Sequence":{"atoms":[2,3]}}],"root":7},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"dashed","render":{},"derive":{},"tests":[{"entry":"dashed","kind":"accept","input":"-ab","expect":{}},{"entry":"dashed","kind":"capture","input":"-ab","expect":{"dash":"-","code":"ab"}},{"entry":"dashed","kind":"capture","input":"ab","expect":{"code":"ab"}},{"entry":"dashed","kind":"reject","input":"-a","expect":{}},{"entry":"dashed","kind":"reject","input":"abc","expect":{}}],"docs":{"pair":"Exactly two letters, captured as one string.","dashed":"An optional dash prefix, then the pair."},"source":"## Semantics: T1, C3, C4, K1, V2, V3, B1, B3, A1, A2, M0\ngrammar ConformanceRepetition version \"1.0.0\" mode \"v1\" {\n  ## Exactly two letters, captured as one string.\n  pair = 2*2(%x61-7A) as code\n  ## An optional dash prefix, then the pair.\n  dashed = [ \"-\" as dash ] pair\n\n  entry dashed: dashed\n\n  test dashed {\n    accept \"-ab\"\n    capture \"-ab\" { dash: \"-\"\n      code: \"ab\" }\n    capture \"ab\" { code: \"ab\" }\n    reject \"-a\"\n    reject \"abc\"\n  }\n}\n","source_hash":"2ef0303dbde9582a2c9ef495aa24a9f030868b406b10ab20dd552ece4a75f1e0","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.117","edition":1,"semantics_hash":"sha256:e92b06bbe7ee6df688f771f8bd5781fa2a25f6f32b0f9215a523a3d1904a6904","checksum":"sha256:fb549497a7395e7e0c659e66c9d1fa22f505d2d5c49c3844a119e3d8c585d2fc"}
