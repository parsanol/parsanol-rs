  "source": "grammar ConformanceSkip version \"1.0.0\" {\n  ## Whitespace between tokens.\n  trivia = 1*\" \"\n  ## A key = value pair; trivia rides between tokens.\n  main = ( 1*%x61-7A as key ) \"=\" ( 1*%x30-39 as value )\n\n  skip = trivia\n\n  bindings main {\n    key -> key\n    value -> value\n  }\n\n  entry main: main\n\n  test main {\n    accept \"abc=42\"\n    accept \"  abc = 42\"\n    example \"abc=42\" { key: \"abc\"\n      value: \"42\" }\n    reject \"abc = \"\n  }\n}\n",
