## Semantics: C7, T3, C3, K1, A1, A2, M0
grammar ConformanceEntries version "1.0.0" {
  ## Two entries over one rule set; every test names its entry.
  word = 1*%x61-7A as word
  num = 1*%x30-39 as num

  entry word: word
  entry num: num

  test word {
    accept "abc"
    reject "123"
    capture "abc" { word: "abc" }
  }

  test num {
    accept "42"
    reject "abc"
    capture "42" { num: "42" }
  }
}
