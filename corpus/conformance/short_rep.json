{"bindings":null,"version":"1.0.0","grammar":"ConformanceShortRep","shape":"parsanol-tree/v2","binding_version":1,"entries":{"short":{"root":"short","grammar":{"atoms":[{"Re":{"pattern":"[\\x61-\\x7a]"}},{"Repetition":{"atom":0,"min":1,"max":3,"tag":"Repetition"}},{"Named":{"name":"code","atom":1}}],"root":2},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"short","render":{},"derive":{},"tests":[{"entry":"short","kind":"capture","input":"ab","expect":{"code":"ab"}},{"entry":"short","kind":"capture","input":"abc","expect":{"code":"abc"}},{"entry":"short","kind":"reject","input":"abcd","expect":{}},{"entry":"short","kind":"reject","input":"","expect":{}}],"docs":{"short":"One to three letters, captured."},"source":"## Semantics: T3, C3, K1, V3, B3, A1, A2, M0\ngrammar ConformanceShortRep version \"1.0.0\" {\n  ## One to three letters, captured.\n  short = 1*3(%x61-7A) as code\n\n  entry short: short\n\n  test short {\n    capture \"ab\" { code: \"ab\" }\n    capture \"abc\" { code: \"abc\" }\n    reject \"abcd\"\n    reject \"\"\n  }\n}\n","source_hash":"6e2f32a0ed43d6bd8e48aaa71b5f4ba84bc78fa2245682af4e60724cc9fdc67b","compiler_version":"1.3.96","checksum":"sha256:2d6385836f172099fcab6cefc87895e7bcd047095865a0324a2561ac29fdbd2d"}