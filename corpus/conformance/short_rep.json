{"bindings":null,"version":"1.0.0","grammar":"ConformanceShortRep","shape":"parsanol-tree/v2","binding_version":1,"entries":{"short":{"root":"short","grammar":{"atoms":[{"Re":{"pattern":"[\\x61-\\x7a]"}},{"Repetition":{"atom":0,"min":1,"max":3,"tag":"Repetition"}},{"Named":{"name":"code","atom":1}}],"root":2},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"short","render":{},"derive":{},"tests":[{"entry":"short","kind":"capture","input":"ab","expect":{"code":"ab"}},{"entry":"short","kind":"capture","input":"abc","expect":{"code":"abc"}},{"entry":"short","kind":"reject","input":"abcd","expect":{}},{"entry":"short","kind":"reject","input":"","expect":{}}],"docs":{"short":"One to three letters, captured."},"source":"## Semantics: T3, C3, K1, V3, B3, A1, A2, M0\ngrammar ConformanceShortRep version \"1.0.0\" mode \"v1\" {\n  ## One to three letters, captured.\n  short = 1*3(%x61-7A) as code\n\n  entry short: short\n\n  test short {\n    capture \"ab\" { code: \"ab\" }\n    capture \"abc\" { code: \"abc\" }\n    reject \"abcd\"\n    reject \"\"\n  }\n}\n","source_hash":"bd610b7f2a8e6c5113b9f2db194f160c5bcc3bc31f95a5e62d65b546d81461f3","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.111","edition":"v1","checksum":"sha256:1fea590647e75ebd6a8326ed7f625a26208d9df11df00a98436296eaf312dab2"}
