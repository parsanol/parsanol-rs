  "source": "grammar ConformanceShortRep version \"1.0.0\" {\n  ## One to three letters, captured.\n  short = 1*3(%x61-7A) as code\n\n  bindings short {\n    code -> code (string)\n  }\n\n  entry short: short\n\n  test short {\n    example \"ab\" { code: \"ab\" }\n    example \"abc\" { code: \"abc\" }\n    reject \"abcd\"\n    reject \"\"\n  }\n}\n",
