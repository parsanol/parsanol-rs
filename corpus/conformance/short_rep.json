{"bindings":null,"version":"1.0.0","grammar":"ConformanceShortRep","shape":"parsanol-tree/v2","binding_version":1,"entries":{"short":{"root":"short","grammar":{"atoms":[{"Re":{"pattern":"[\\x61-\\x7a]"}},{"Repetition":{"atom":0,"min":1,"max":3,"tag":"Repetition"}},{"Named":{"name":"code","atom":1}}],"root":2},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"short","render":{},"derive":{},"tests":[{"entry":"short","kind":"capture","input":"ab","expect":{"code":"ab"}},{"entry":"short","kind":"capture","input":"abc","expect":{"code":"abc"}},{"entry":"short","kind":"reject","input":"abcd","expect":{}},{"entry":"short","kind":"reject","input":"","expect":{}}],"docs":{"short":"One to three letters, captured."},"source":"## Semantics: T3, C3, K1, V3, B3, A1, A2, M0\ngrammar ConformanceShortRep version \"1.0.0\" edition \"v1\" {\n  ## One to three letters, captured.\n  short = 1*3(%x61-7A) as code\n\n  entry short: short\n\n  test short {\n    capture \"ab\" { code: \"ab\" }\n    capture \"abc\" { code: \"abc\" }\n    reject \"abcd\"\n    reject \"\"\n  }\n}\n","source_hash":"8ebc5a7ffa1224904bd9e93869618b7f235bf677bc4df0a672bc3b74a0067807","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.117","edition":1,"semantics_hash":"sha256:a608abd948e38ecc5adf00ee6ce05c502cb2d341844ce8f08337b38ef52e5bf2","checksum":"sha256:2e992426b91ef15a93434947c02dc0dc66514386ad9aabb145479804ace47dc8"}
