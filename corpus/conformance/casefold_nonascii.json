{"bindings":null,"version":"1.0.0","grammar":"ConformanceCasefoldUnicode","shape":"parsanol-tree/v2","binding_version":1,"entries":{"main":{"root":"main","grammar":{"atoms":[{"Re":{"pattern":"(?i:é)"}},{"Re":{"pattern":"[!]"}},{"Sequence":{"atoms":[0,1]}}],"root":2},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"main","render":{},"derive":{},"tests":[{"entry":"main","kind":"accept","input":"é!","expect":{}},{"entry":"main","kind":"accept","input":"É!","expect":{}},{"entry":"main","kind":"reject","input":"e!","expect":{}}],"docs":{"main":"Case-insensitive literal with a non-ASCII letter."},"source":"## Semantics: T2, T1, C1, M0, A1\ngrammar ConformanceCasefoldUnicode version \"1.0.0\" {\n  ## Case-insensitive literal with a non-ASCII letter.\n  main = %i\"é\" %x21\n\n  entry main: main\n\n  test main {\n    accept \"é!\"\n    accept \"É!\"\n    reject \"e!\"\n  }\n}\n","source_hash":"96003aeffd5200d72d325f938e203733f2250160caef10d3d4f11c5e42724090","compiler_version":"1.3.97","checksum":"sha256:1f4e04ef23ee9c7c078285e05db7be21d41d408f93dc67ae821427099b73f54a"}