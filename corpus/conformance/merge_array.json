{"bindings":null,"version":"1.0.0","grammar":"ConformanceMergeArray","shape":"parsanol-tree/v2","binding_version":1,"entries":{"main":{"root":"main","grammar":{"atoms":[{"Str":{"pattern":"a"}},{"Named":{"name":"x","atom":0}},{"Repetition":{"atom":1,"min":1,"max":null,"tag":"Repetition"}},{"Str":{"pattern":"b"}},{"Named":{"name":"y","atom":3}},{"Sequence":{"atoms":[2,4]}}],"root":5},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"main","render":{},"derive":{},"tests":[{"entry":"main","kind":"shape","input":"aab","expect":[{"x":"a"},{"x":"a"},{"y":"b"}]}],"docs":{"main":"A repetition (array value) followed by a capture hoists into one array."},"source":"## Semantics: V1, V3, C1, C3, K1, A1, A2, M0\ngrammar ConformanceMergeArray version \"1.0.0\" edition \"v1\" {\n  ## A repetition (array value) followed by a capture hoists into one array.\n  main = ( 1*( \"a\" as x ) ) ( \"b\" as y )\n\n  entry main: main\n\n  test main {\n    shape \"aab\" [ { x: \"a\" }, { x: \"a\" }, { y: \"b\" } ]\n  }\n}\n","source_hash":"4768a9aa42f00a2f9b7c68b350c8187b773466041fe1aad0d91fa9c2d126d953","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.117","edition":1,"semantics_hash":"sha256:13fd7524d3ed4d53a1c19546a9e77945483e5a34e0a83de1889ae12c49cb185b","checksum":"sha256:0f1772f24314c221e10ca6f6b676326f148d05bb4a4a66f41c4e0047c21c0f57"}
