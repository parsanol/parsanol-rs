{"bindings":null,"version":"1.0.0","grammar":"ConformanceMergeArray","shape":"parsanol-tree/v2","binding_version":1,"entries":{"main":{"root":"main","grammar":{"atoms":[{"Str":{"pattern":"a"}},{"Named":{"name":"x","atom":0}},{"Repetition":{"atom":1,"min":1,"max":null,"tag":"Repetition"}},{"Str":{"pattern":"b"}},{"Named":{"name":"y","atom":3}},{"Sequence":{"atoms":[2,4]}}],"root":5},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"main","render":{},"derive":{},"tests":[{"entry":"main","kind":"shape","input":"aab","expect":[{"x":"a"},{"x":"a"},{"y":"b"}]}],"docs":{"main":"A repetition (array value) followed by a capture hoists into one array."},"source":"## Semantics: V1, V3, C1, C3, K1, A1, A2, M0\ngrammar ConformanceMergeArray version \"1.0.0\" mode \"v1\" {\n  ## A repetition (array value) followed by a capture hoists into one array.\n  main = ( 1*( \"a\" as x ) ) ( \"b\" as y )\n\n  entry main: main\n\n  test main {\n    shape \"aab\" [ { x: \"a\" }, { x: \"a\" }, { y: \"b\" } ]\n  }\n}\n","source_hash":"71869817037ab31046480af4cfe792a15cc23e34735e9a28b2116172871f4d19","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.117","edition":1,"semantics_hash":"sha256:cab1356b5d63e9e79dc415196726e99bdd33d39cbe0bc22c8b57e3932d012930","checksum":"sha256:f2d2ed660e595a53a9dbadc5031d129ee078b0a637ea9f22eb1f3d9a668b0e8d"}
