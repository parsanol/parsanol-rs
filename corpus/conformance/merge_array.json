{"bindings":null,"version":"1.0.0","grammar":"ConformanceMergeArray","shape":"parsanol-tree/v2","binding_version":1,"entries":{"main":{"root":"main","grammar":{"atoms":[{"Str":{"pattern":"a"}},{"Named":{"name":"x","atom":0}},{"Repetition":{"atom":1,"min":1,"max":null,"tag":"Repetition"}},{"Str":{"pattern":"b"}},{"Named":{"name":"y","atom":3}},{"Sequence":{"atoms":[2,4]}}],"root":5},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"main","render":{},"derive":{},"tests":[{"entry":"main","kind":"shape","input":"aab","expect":[{"x":"a"},{"x":"a"},{"y":"b"}]}],"docs":{"main":"A repetition (array value) followed by a capture hoists into one array."},"source":"## Semantics: V1, V3, C1, C3, K1, A1, A2, M0\ngrammar ConformanceMergeArray version \"1.0.0\" edition \"v2\" {\n  ## A repetition (array value) followed by a capture hoists into one array.\n  main = ( 1*( \"a\" as x ) ) ( \"b\" as y )\n\n  entry main: main\n\n  test main {\n    shape \"aab\" [ { x: \"a\" }, { x: \"a\" }, { y: \"b\" } ]\n  }\n}\n","source_hash":"da76698f914cb25640ee3f7f53cf87b8fd8f07f03ce3d0bfcc868df73929ace2","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.126","edition":2,"semantics_hash":"sha256:9a6b85c16520fb981fdc81e403b4cc227de576d71512c26f4a377fde617830d3","checksum":"sha256:7ad553ffc866eab6df1f8f2ec7bd6928205b8701072ff65237a56ec35f70aea6"}
