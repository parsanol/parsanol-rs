{"bindings":null,"version":"1.0.0","grammar":"ConformanceUnicodeAny","shape":"parsanol-tree/v2","binding_version":1,"entries":{"main":{"root":"run","grammar":{"atoms":[{"Re":{"pattern":"[\\x00-\\u{10ffff}]"}},{"Repetition":{"atom":0,"min":2,"max":4,"tag":"Repetition"}}],"root":1},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"main","render":{},"derive":{},"tests":[{"entry":"main","kind":"accept","input":"日本語","expect":{}},{"entry":"main","kind":"accept","input":"ab","expect":{}},{"entry":"main","kind":"accept","input":"日本語x","expect":{}},{"entry":"main","kind":"reject","input":"日","expect":{}},{"entry":"main","kind":"reject","input":"日本語x!","expect":{}},{"entry":"main","kind":"shape","input":"日本語x","expect":"日本語x"}],"docs":{"run":"A bounded run of any codepoints."},"source":"## Semantics: U1 (rs#297) — `.` matches whole codepoints; min/max are\n## codepoint counts; no span may split a character.\ngrammar ConformanceUnicodeAny version \"1.0.0\" edition \"v1\" {\n  ## A bounded run of any codepoints.\n  run = 2*4 ANY\n\n  entry main: run\n\n  test main {\n    accept \"日本語\"\n    accept \"ab\"\n    accept \"日本語x\"\n    reject \"日\"\n    reject \"日本語x!\"\n    shape \"日本語x\" \"日本語x\"\n  }\n}\n","source_hash":"597edc855e3e338eee669dc6f99d5e08cc722a1a626cf86565278c51b07cc30c","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.117","edition":1,"semantics_hash":"sha256:b12b06e10572c5d4295dd19232655c56f8179c234fe85cf6f8145dca4b670f33","checksum":"sha256:9e0d7347c9202f743868c3ab7541bca0d001a1dd4a18146240e0fb14c341fa54"}
