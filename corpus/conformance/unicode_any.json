{"bindings":null,"version":"1.0.0","grammar":"ConformanceUnicodeAny","shape":"parsanol-tree/v2","binding_version":1,"entries":{"main":{"root":"run","grammar":{"atoms":[{"Re":{"pattern":"[\\x00-\\u{10ffff}]"}},{"Repetition":{"atom":0,"min":2,"max":4,"tag":"Repetition"}}],"root":1},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"main","render":{},"derive":{},"tests":[{"entry":"main","kind":"accept","input":"日本語","expect":{}},{"entry":"main","kind":"accept","input":"ab","expect":{}},{"entry":"main","kind":"accept","input":"日本語x","expect":{}},{"entry":"main","kind":"reject","input":"日","expect":{}},{"entry":"main","kind":"reject","input":"日本語x!","expect":{}},{"entry":"main","kind":"shape","input":"日本語x","expect":"日本語x"}],"docs":{"run":"A bounded run of any codepoints."},"source":"## Semantics: U1 (rs#297) — `.` matches whole codepoints; min/max are\n## codepoint counts; no span may split a character.\ngrammar ConformanceUnicodeAny version \"1.0.0\" mode \"classic\" {\n  ## A bounded run of any codepoints.\n  run = 2*4 ANY\n\n  entry main: run\n\n  test main {\n    accept \"日本語\"\n    accept \"ab\"\n    accept \"日本語x\"\n    reject \"日\"\n    reject \"日本語x!\"\n    shape \"日本語x\" \"日本語x\"\n  }\n}\n","source_hash":"ec033c32d0289db370fb7062a47dbd753d1dc413777926349bcd58ed92ccdcbf","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.109","mode":"classic","checksum":"sha256:0ed5ce186c95c682f70347d2bd7b2120b22c562ab43db56f26a9bb71ea9cd956"}
