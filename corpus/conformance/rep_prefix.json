  "docs": {},
  "source": "## rs#334: a repetition whose iteration consumes an operator and then\n## fails inside its trailing operand must ROLL the iteration back —\n## operator-suffixed trailing junk stays junk on every engine, and a\n## multi-character case-insensitive operator matches its full length.\ngrammar RepPrefix version \"1.0.0\" {\n  ws = 1*( %x20 / %x09 )\n  pq = *ws\n  alpha = %x41-5A / %x61-7A\n  name = 1*( alpha / %x30-39 / %x5F ) as variable\n  primary = ( %x54 / %x46 ) 1*( alpha ) as literal / name / ( \"(\" pq or pq \")\" )\n  not = ( ( %x21 ) / %i\"NOT\" pq ) pq primary / pq primary\n  and = not *( pq ( %i\"AND\" ) pq not )\n  or = and *( pq ( %i\"OR\" ) pq and )\n  top = pq or pq\n\n  entry main: top\n\n  test {\n    accept \"a AND b\"\n    accept \"a OR NOT b\"\n    accept \"!(a AND b) OR TRUE\"\n    accept \"x1 AND x2 AND (x3 OR x4)\"\n    reject \"a AND\"\n    reject \"AND a\"\n    reject \"a AND (b\"\n  }\n}\n",
