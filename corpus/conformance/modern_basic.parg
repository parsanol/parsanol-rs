## Modern mode (ruby#304): uncaptured rule references are named at
## compile time — Named(rule_name) — so every engine builds a fully
## named tree from ordinary Named atoms.
grammar ModernBasic version "1.0.0" mode "v2" {
  ## A sep reference produces no capture: modern mode names it `sep`.
  sep = ","
  item = ( 1*( %x61-7A ) ) as k
  main = sep item

  entry main: main

  test {
    accept ",abc"
    capture ",abc" { k: "abc" }
  }
}
