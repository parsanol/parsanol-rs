{"bindings":null,"version":"1.0.0","grammar":"ConformanceBindingsArray","shape":"parsanol-tree/v2","binding_version":1,"entries":{"main":{"root":"main","grammar":{"atoms":[{"Entity":{"atom":3}},{"Re":{"pattern":"[\\x30-\\x39]"}},{"Repetition":{"atom":1,"min":1,"max":null,"tag":"Repetition"}},{"Named":{"name":"n","atom":2}},{"Str":{"pattern":","}},{"Entity":{"atom":3}},{"Sequence":{"atoms":[4,5]}},{"Repetition":{"atom":6,"min":0,"max":null,"tag":"Repetition"}},{"Sequence":{"atoms":[0,7]}}],"root":8},"bindings":[{"capture":"n","path":"items[].n","type":"integer","card":null,"preprocess":null}]}},"preprocess":{},"tables":{},"lint":{"order_warnings":[]},"default_entry":"main","render":{},"derive":{},"tests":[{"entry":"main","kind":"example","input":"1,2","expect":{"items":[{"n":1},{"n":2}]}},{"entry":"main","kind":"example","input":"7","expect":{"items":[{"n":7}]}},{"entry":"main","kind":"reject","input":"1,","expect":{}}],"docs":{"item":"Comma-separated integers bound as an array of objects."},"source":"## Semantics: B1, B2, B3, B4, C3, K1, A1, A3, M0\ngrammar ConformanceBindingsArray version \"1.0.0\" mode \"classic\" {\n  ## Comma-separated integers bound as an array of objects.\n  item = 1*%x30-39 as n\n  main = item *( \",\" item )\n\n  bindings main {\n    n -> items[].n (integer)\n  }\n\n  entry main: main\n\n  test main {\n    example \"1,2\" { items: [ { n: 1 }, { n: 2 } ] }\n    example \"7\" { items: [ { n: 7 } ] }\n    reject \"1,\"\n  }\n}\n","source_hash":"f072fef1e9706de35afee334c18ecfb0baa1557a5ed5a300a13a4ed2fdc6c2a7","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.109","mode":"classic","checksum":"sha256:e9d0b6af4504990e9d17235d1545c37996d57c080981cce878062c58e8748ce2"}
