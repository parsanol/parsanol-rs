{"bindings":null,"version":"1.0.0","grammar":"ConformanceTableOverlap","shape":"parsanol-tree/v2","binding_version":1,"entries":{"main":{"root":"main","grammar":{"atoms":[{"Str":{"pattern":"AB"}},{"Str":{"pattern":"A"}},{"Alternative":{"atoms":[0,1]}},{"Re":{"pattern":"[!]"}},{"Sequence":{"atoms":[2,3]}}],"root":4},"bindings":[]}},"preprocess":{},"tables":{"overlap":{"file":"overlap.yaml","rows":[{"code":"A"},{"code":"AB"}]}},"lint":{"order_warnings":[]},"default_entry":"main","render":{},"derive":{},"tests":[{"entry":"main","kind":"accept","input":"AB!","expect":{}},{"entry":"main","kind":"accept","input":"A!","expect":{}},{"entry":"main","kind":"reject","input":"B!","expect":{}}],"docs":{"main":"Longest-first table expansion: \"AB\" must be tried before \"A\"."},"source":"## Semantics: D1, D2, C2, T1, M0, A1\ngrammar ConformanceTableOverlap version \"1.0.0\" edition \"v1\" {\n  ## Longest-first table expansion: \"AB\" must be tried before \"A\".\n  main = alt from_table \"overlap\" column \"code\" %x21\n\n  entry main: main\n\n  test main {\n    accept \"AB!\"\n    accept \"A!\"\n    reject \"B!\"\n  }\n}\n","source_hash":"79db44f39e86b2433174b209a812da77387fe7244541904bf87da4d70428660b","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.117","edition":1,"semantics_hash":"sha256:37049726cc6672c32ae982017eea38f6e58e0de16b072b01342fadf535c7fac0","checksum":"sha256:1d0187a85dbc40e26d25cd34782ed292996be2bab52ad8f9d55cb080e636ce23"}
