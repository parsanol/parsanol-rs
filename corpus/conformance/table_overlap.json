{"bindings":null,"version":"1.0.0","grammar":"ConformanceTableOverlap","shape":"parsanol-tree/v2","binding_version":1,"entries":{"main":{"root":"main","grammar":{"atoms":[{"Str":{"pattern":"AB"}},{"Str":{"pattern":"A"}},{"Alternative":{"atoms":[0,1]}},{"Re":{"pattern":"[!]"}},{"Sequence":{"atoms":[2,3]}}],"root":4},"bindings":[]}},"preprocess":{},"tables":{"overlap":{"file":"overlap.yaml","rows":[{"code":"A"},{"code":"AB"}]}},"lint":{"order_warnings":[]},"default_entry":"main","render":{},"derive":{},"tests":[{"entry":"main","kind":"accept","input":"AB!","expect":{}},{"entry":"main","kind":"accept","input":"A!","expect":{}},{"entry":"main","kind":"reject","input":"B!","expect":{}}],"docs":{"main":"Longest-first table expansion: \"AB\" must be tried before \"A\"."},"source":"## Semantics: D1, D2, C2, T1, M0, A1\ngrammar ConformanceTableOverlap version \"1.0.0\" mode \"classic\" {\n  ## Longest-first table expansion: \"AB\" must be tried before \"A\".\n  main = alt from_table \"overlap\" column \"code\" %x21\n\n  entry main: main\n\n  test main {\n    accept \"AB!\"\n    accept \"A!\"\n    reject \"B!\"\n  }\n}\n","source_hash":"b0d1f745234c59347167b2a54fe3474fa24ec4373310053210289835c3735955","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.109","mode":"classic","checksum":"sha256:979d984295b243edef56f0dcd3e05f1a20271c2e3117bb785c564e4a970b2f11"}
