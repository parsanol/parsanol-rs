{"bindings":null,"version":"1.0.0","grammar":"ConformanceTableOverlap","shape":"parsanol-tree/v2","binding_version":1,"entries":{"main":{"root":"main","grammar":{"atoms":[{"Str":{"pattern":"AB"}},{"Str":{"pattern":"A"}},{"Alternative":{"atoms":[0,1]}},{"Re":{"pattern":"[!]"}},{"Sequence":{"atoms":[2,3]}}],"root":4},"bindings":[]}},"preprocess":{},"tables":{"overlap":{"file":"overlap.yaml","rows":[{"code":"A"},{"code":"AB"}]}},"lint":{"order_warnings":[]},"default_entry":"main","render":{},"derive":{},"tests":[{"entry":"main","kind":"accept","input":"AB!","expect":{}},{"entry":"main","kind":"accept","input":"A!","expect":{}},{"entry":"main","kind":"reject","input":"B!","expect":{}}],"docs":{"main":"Longest-first table expansion: \"AB\" must be tried before \"A\"."},"source":"## Semantics: D1, D2, C2, T1, M0, A1\ngrammar ConformanceTableOverlap version \"1.0.0\" edition \"v2\" {\n  ## Longest-first table expansion: \"AB\" must be tried before \"A\".\n  main = alt from_table \"overlap\" column \"code\" %x21\n\n  entry main: main\n\n  test main {\n    accept \"AB!\"\n    accept \"A!\"\n    reject \"B!\"\n  }\n}\n","source_hash":"2f3b7fb255227a058134226bed0c3b5b675d457aadf51cf22db5f02be69f977a","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.126","edition":2,"semantics_hash":"sha256:b11b3ac5f1eb596338a01503b967f415468dfaedb28f3762f5ebfccd0c8d3a26","checksum":"sha256:3401901a674e8daf0b3fba06e447a417334ac37713621b99a4f0f6007d824f79"}
