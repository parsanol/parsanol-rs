  "source": "grammar ConformanceLookbehind version \"1.0.0\" {\n  ## Emphasis: a star not preceded by a letter, content, star.\n  emph = ( !< %x61-7A \"*\" 1*( !\"*\" ANY ) \"*\" ) as emph\n  ## Words and emphasis.\n  main = 1*( emph / ( !\"*\" ANY ) )\n\n  bindings main {\n    emph -> emph\n  }\n\n  entry main: main\n\n  test main {\n    example \"*cool*\" { emph: \"*cool*\" }\n    reject \"a*b*\"\n  }\n}\n",
