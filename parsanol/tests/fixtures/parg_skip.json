    "source": "grammar SkipParity version \"1\" {\n  skip = trivia\n  trivia = 1*( ( 1*\" \" ) / comment )\n  comment = \"(*\" *( comment / ( !\"*)\" ANY ) ) \"*)\"\n  atomic word = ( 1*( ALPHA ) )\n  num = ( 1*( DIGIT ) )\n  sep = \",\"\n  item = ( word / num ) as item\n  list = ( item *( sep item ) ) as list\n  entry document: list\n  test { accept \"foo\" }\n  test { accept \"foo, bar\" }\n  test { accept \"foo ,bar\" }\n  test { accept \"(* note *) foo\" }\n  test { accept \"foo (* tail comment *)\" }\n  test { accept \"(* outer (* inner *) tail *) foo, bar (* end *)\" }\n  test { accept \"  foo  ,  bar  \" }\n  test { reject \"foo,\" }\n  test { reject \"!!!\" }\n  test { reject \"foo bar\" }\n}\n",
