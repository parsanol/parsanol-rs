{"source":"## Semantics: V1, V3, C1, C3, K1, A1, A2, M0\ngrammar ConformanceMergeArray version \"1.0.0\" {\n  ## A repetition (array value) followed by a capture hoists into one array.\n  main = ( 1*( \"a\" as x ) ) ( \"b\" as y )\n\n  entry main: main\n\n  test main {\n    shape \"aab\" [ { x: \"a\" }, { x: \"a\" }, { y: \"b\" } ]\n  }\n}\n","tokens":[{"type":"doc","value":"## Semantics: V1, V3, C1, C3, K1, A1, A2, M0","offset":0},{"type":"newline","value":"\n","offset":44},{"type":"ident","value":"grammar","offset":45},{"type":"ident","value":"ConformanceMergeArray","offset":53},{"type":"ident","value":"version","offset":75},{"type":"str","value":"\"1.0.0\"","offset":83},{"type":"punct","value":"{","offset":91},{"type":"newline","value":"\n","offset":92},{"type":"doc","value":"## A repetition (array value) followed by a capture hoists into one array.","offset":95},{"type":"newline","value":"\n","offset":169},{"type":"ident","value":"main","offset":172},{"type":"punct","value":"=","offset":177},{"type":"punct","value":"(","offset":179},{"type":"num","value":"1","offset":181},{"type":"punct","value":"*","offset":182},{"type":"punct","value":"(","offset":183},{"type":"str","value":"\"a\"","offset":185},{"type":"ident","value":"as","offset":189},{"type":"ident","value":"x","offset":192},{"type":"punct","value":")","offset":194},{"type":"punct","value":")","offset":196},{"type":"punct","value":"(","offset":198},{"type":"str","value":"\"b\"","offset":200},{"type":"ident","value":"as","offset":204},{"type":"ident","value":"y","offset":207},{"type":"punct","value":")","offset":209},{"type":"newline","value":"\n","offset":210},{"type":"newline","value":"\n","offset":211},{"type":"ident","value":"entry","offset":214},{"type":"ident","value":"main","offset":220},{"type":"punct","value":":","offset":224},{"type":"ident","value":"main","offset":226},{"type":"newline","value":"\n","offset":230},{"type":"newline","value":"\n","offset":231},{"type":"ident","value":"test","offset"