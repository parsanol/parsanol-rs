{"source":"## Semantics: U1 (rs#297) — the quoted-string idiom over multibyte text:\n## the negated-class run advances by whole codepoints.\ngrammar ConformanceUnicodeQuoted version \"1.0.0\" {\n  ## A quoted string whose body is any codepoints except quote/backslash.\n  quoted = \"\\\"\" *( !(\"\\\"\" / \"\\\\\") ANY ) \"\\\"\"\n\n  entry main: quoted\n\n  test main {\n    accept \"\\\"日本語 中文\\\"\"\n    accept \"\\\"emoji 🎉🚀 here\\\"\"\n    accept \"\\\"ascii too\\\"\"\n    reject \"\\\"unterminated\"\n    reject \"\\\"mixed ☃\\\" trailing\"\n  }\n}\n","tokens":[{"type":"doc","value":"## Semantics: U1 (rs#297) — the quoted-string idiom over multibyte text:","offset":0},{"type":"newline","value":"\n","offset":72},{"type":"doc","value":"## the negated-class run advances by whole codepoints.","offset":73},{"type":"newline","value":"\n","offset":127},{"type":"ident","value":"grammar","offset":128},{"type":"ident","value":"ConformanceUnicodeQuoted","offset":136},{"type":"ident","value":"version","offset":161},{"type":"str","value":"\"1.0.0\"","offset":169},{"type":"punct","value":"{","offset":177},{"type":"newline","value":"\n","offset":178},{"type":"doc","value":"## A quoted string whose body is any codepoints except quote/backslash.","offset":181},{"type":"newline","value":"\n","offset":252},{"type":"ident","value":"quoted","offset":255},{"type":"punct","value":"=","offset":262},{"type":"str","value":"\"\\\"\"","offset":264},{"type":"punct","value":"*","offset":269},{"type":"punct","value":"(","offset":270},{"type":"punct","value":"!","offset":272},{"type":"punct","value":"(","offset":273},{"type":"str","value":"\"\\\"\"","offset":274},{"type":"punct","value":"/","offset":279},{"type":"str","value":"\"\\\\\"","offset":281},{"type":"punct","value":")","offset":285},{"type":"ident","value":"ANY","offset":287},{"type":"punct","value":")","offset":291},{"type":"str","value":"\"\\\"\"","offset":293},{"type":"newline","value":"\n","offset":297},{"type":"newline","value":"\n