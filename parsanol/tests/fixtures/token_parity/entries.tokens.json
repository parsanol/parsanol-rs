{"source":"## Semantics: C7, T3, C3, K1, A1, A2, M0\ngrammar ConformanceEntries version \"1.0.0\" {\n  ## Two entries over one rule set; every test names its entry.\n  word = 1*%x61-7A as word\n  num = 1*%x30-39 as num\n\n  entry word: word\n  entry num: num\n\n  test word {\n    accept \"abc\"\n    reject \"123\"\n    capture \"abc\" { word: \"abc\" }\n  }\n\n  test num {\n    accept \"42\"\n    reject \"abc\"\n    capture \"42\" { num: \"42\" }\n  }\n}\n","tokens":[{"type":"doc","value":"## Semantics: C7, T3, C3, K1, A1, A2, M0","offset":0},{"type":"newline","value":"\n","offset":40},{"type":"ident","value":"grammar","offset":41},{"type":"ident","value":"ConformanceEntries","offset":49},{"type":"ident","value":"version","offset":68},{"type":"str","value":"\"1.0.0\"","offset":76},{"type":"punct","value":"{","offset":84},{"type":"newline","value":"\n","offset":85},{"type":"doc","value":"## Two entries over one rule set; every test names its entry.","offset":88},{"type":"newline","value":"\n","offset":149},{"type":"ident","value":"word","offset":152},{"type":"punct","value":"=","offset":157},{"type":"num","value":"1","offset":159},{"type":"punct","value":"*","offset":160},{"type":"hex","value":"61-7A","offset":161},{"type":"ident","value":"as","offset":169},{"type":"ident","value":"word","offset":172},{"type":"newline","value":"\n","offset":176},{"type":"ident","value":"num","offset":179},{"type":"punct","value":"=","offset":183},{"type":"num","value":"1","offset":185},{"type":"punct","value":"*","offset":186},{"type":"hex","value":"30-39","offset":187},{"type":"ident","value":"as","offset":195},{"type":"ident","value":"num","offset":198},{"type":"newline","value":"\n","offset":201},{"type":"newline","value":"\n","offset":202},{"type":"ident","value":"entry","offset":205},{"type":"ident","value":"word","offset":211},{"type":"punct","value":":","offset":215},{"type":"ident","value":"word","offset":217},{"type":"newline","value":"\n","offset":221},{"type":"ident","valu