{"source":"## Semantics: D1, D2, B5, B3, M0, A1\ngrammar ConformanceTable version \"1.0.0\" {\n  ## A stage abbreviation resolved through the stages table.\n  main = alt from_table \"stages\" column \"abbr\" as abbr\n\n  preprocess resolve {\n    table_lookup stages abbr -> code\n  }\n\n  bindings main {\n    abbr -> code (string) preprocess: resolve\n  }\n\n  entry main: main\n\n  test main {\n    accept \"DIS\"\n    accept \"IS\"\n    reject \"XX\"\n    # example-level assertions on the preprocessed binding are gated on\n    # the native preprocess row lookup (parsanol-rs: embedded table rows\n    # are not reachable from the native bind path yet)\n  }\n}\n","tokens":[{"type":"doc","value":"## Semantics: D1, D2, B5, B3, M0, A1","offset":0},{"type":"newline","value":"\n","offset":36},{"type":"ident","value":"grammar","offset":37},{"type":"ident","value":"ConformanceTable","offset":45},{"type":"ident","value":"version","offset":62},{"type":"str","value":"\"1.0.0\"","offset":70},{"type":"punct","value":"{","offset":78},{"type":"newline","value":"\n","offset":79},{"type":"doc","value":"## A stage abbreviation resolved through the stages table.","offset":82},{"type":"newline","value":"\n","offset":140},{"type":"ident","value":"main","offset":143},{"type":"punct","value":"=","offset":148},{"type":"ident","value":"alt","offset":150},{"type":"ident","value":"from_table","offset":154},{"type":"str","value":"\"stages\"","offset":165},{"type":"ident","value":"column","offset":174},{"type":"str","value":"\"abbr\"","offset":181},{"type":"ident","value":"as","offset":188},{"type":"ident","value":"abbr","offset":191},{"type":"newline","value":"\n","offset":195},{"type":"newline","value":"\n","offset":196},{"type":"ident","value":"preprocess","offset":199},{"type":"ident","value":"resolve","offset":210},{"type":"punct","value":"{","offset":218},{"type":"newline","value":"\n","offset":219},{"type":"ident","value":"table_lookup","offset":224},{"type":"ident","value":"stages","offse