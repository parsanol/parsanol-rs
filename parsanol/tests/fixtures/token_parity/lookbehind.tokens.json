{"source":"## Semantics: T3, C5, C6, K1, V3, M0, A1, A2\ngrammar ConformanceLookbehind version \"1.0.0\" {\n  ## Emphasis: a star not preceded by a letter, content, star.\n  emph = ( !< %x61-7A \"*\" 1*( !\"*\" ANY ) \"*\" ) as emph\n  ## Words and emphasis.\n  main = 1*( emph / ( !\"*\" ANY ) )\n\n  entry main: main\n\n  test main {\n    capture \"*cool*\" { emph: \"*cool*\" }\n    reject \"a*b*\"\n  }\n}\n","tokens":[{"type":"doc","value":"## Semantics: T3, C5, C6, K1, V3, M0, A1, A2","offset":0},{"type":"newline","value":"\n","offset":44},{"type":"ident","value":"grammar","offset":45},{"type":"ident","value":"ConformanceLookbehind","offset":53},{"type":"ident","value":"version","offset":75},{"type":"str","value":"\"1.0.0\"","offset":83},{"type":"punct","value":"{","offset":91},{"type":"newline","value":"\n","offset":92},{"type":"doc","value":"## Emphasis: a star not preceded by a letter, content, star.","offset":95},{"type":"newline","value":"\n","offset":155},{"type":"ident","value":"emph","offset":158},{"type":"punct","value":"=","offset":163},{"type":"punct","value":"(","offset":165},{"type":"punct","value":"!","offset":167},{"type":"punct","value":"<","offset":168},{"type":"hex","value":"61-7A","offset":170},{"type":"str","value":"\"*\"","offset":178},{"type":"num","value":"1","offset":182},{"type":"punct","value":"*","offset":183},{"type":"punct","value":"(","offset":184},{"type":"punct","value":"!","offset":186},{"type":"str","value":"\"*\"","offset":187},{"type":"ident","value":"ANY","offset":191},{"type":"punct","value":")","offset":195},{"type":"str","value":"\"*\"","offset":197},{"type":"punct","value":")","offset":201},{"type":"ident","value":"as","offset":203},{"type":"ident","value":"emph","offset":206},{"type":"newline","value":"\n","offset":210},{"type":"doc","value":"## Words and emphasis.","offset":213},{"type":"newline","value":"\n","offset":235},{"type":"ident","value":"main","offset":238},{"type":"punct","value":"=","offset":243},{"type":"num"