{"source":"## Semantics: C4, K1, K2, V2, M0, A1, A2\ngrammar ConformanceOptionalCapture version \"1.0.0\" {\n  ## An optional dash prefix captured as a whole: nil when absent.\n  main = ( [ \"-\" ] ) as dash 1*%x61-7A\n\n  entry main: main\n\n  test main {\n    capture \"-ab\" { dash: \"-\" }\n    capture \"ab\" { dash: null }\n    accept \"ab\"\n    reject \"-\"\n  }\n}\n","tokens":[{"type":"doc","value":"## Semantics: C4, K1, K2, V2, M0, A1, A2","offset":0},{"type":"newline","value":"\n","offset":40},{"type":"ident","value":"grammar","offset":41},{"type":"ident","value":"ConformanceOptionalCapture","offset":49},{"type":"ident","value":"version","offset":76},{"type":"str","value":"\"1.0.0\"","offset":84},{"type":"punct","value":"{","offset":92},{"type":"newline","value":"\n","offset":93},{"type":"doc","value":"## An optional dash prefix captured as a whole: nil when absent.","offset":96},{"type":"newline","value":"\n","offset":160},{"type":"ident","value":"main","offset":163},{"type":"punct","value":"=","offset":168},{"type":"punct","value":"(","offset":170},{"type":"punct","value":"[","offset":172},{"type":"str","value":"\"-\"","offset":174},{"type":"punct","value":"]","offset":178},{"type":"punct","value":")","offset":180},{"type":"ident","value":"as","offset":182},{"type":"ident","value":"dash","offset":185},{"type":"num","value":"1","offset":190},{"type":"punct","value":"*","offset":191},{"type":"hex","value":"61-7A","offset":192},{"type":"newline","value":"\n","offset":199},{"type":"newline","value":"\n","offset":200},{"type":"ident","value":"entry","offset":203},{"type":"ident","value":"main","offset":209},{"type":"punct","value":":","offset":213},{"type":"ident","value":"main","offset":215},{"type":"newline","value":"\n","offset":219},{"type":"newline","value":"\n","offset":220},{"type":"ident","value":"test","offset":223},{"type":"ident","value":"main","offset":228},{"type":"punct","value":"{","offset":233},{"type":"newline","value":"\n","offset":234},{"typ