{"source":"## Semantics: C3, K1, K2, B1, B2, B3, A1, A3, M0\ngrammar ConformanceTypes version \"1.0.0\" {\n  ## A year: four digits, cast to integer.\n  main = 4*( %x30-39 ) as year\n\n  bindings main {\n    year -> year (integer)\n  }\n\n  entry main: main\n\n  test main {\n    example \"2020\" { year: 2020 }\n    reject \"20a0\"\n    reject \"123\"\n  }\n}\n","tokens":[{"type":"doc","value":"## Semantics: C3, K1, K2, B1, B2, B3, A1, A3, M0","offset":0},{"type":"newline","value":"\n","offset":48},{"type":"ident","value":"grammar","offset":49},{"type":"ident","value":"ConformanceTypes","offset":57},{"type":"ident","value":"version","offset":74},{"type":"str","value":"\"1.0.0\"","offset":82},{"type":"punct","value":"{","offset":90},{"type":"newline","value":"\n","offset":91},{"type":"doc","value":"## A year: four digits, cast to integer.","offset":94},{"type":"newline","value":"\n","offset":134},{"type":"ident","value":"main","offset":137},{"type":"punct","value":"=","offset":142},{"type":"num","value":"4","offset":144},{"type":"punct","value":"*","offset":145},{"type":"punct","value":"(","offset":146},{"type":"hex","value":"30-39","offset":148},{"type":"punct","value":")","offset":156},{"type":"ident","value":"as","offset":158},{"type":"ident","value":"year","offset":161},{"type":"newline","value":"\n","offset":165},{"type":"newline","value":"\n","offset":166},{"type":"ident","value":"bindings","offset":169},{"type":"ident","value":"main","offset":178},{"type":"punct","value":"{","offset":183},{"type":"newline","value":"\n","offset":184},{"type":"ident","value":"year","offset":189},{"type":"arrow","value":"->","offset":194},{"type":"ident","value":"year","offset":197},{"type":"punct","value":"(","offset":202},{"type":"ident","value":"integer","offset":203},{"type":"punct","value":")","offset":210},{"type":"newline","value":"\n","offset":211},{"type":"punct","value":"}","offset":214},{"type":"newline","value":"\n","offset":215},{"type":"newline","value":"\n","offset"