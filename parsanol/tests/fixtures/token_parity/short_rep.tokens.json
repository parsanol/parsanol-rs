{"source":"## Semantics: T3, C3, K1, V3, B3, A1, A2, M0\ngrammar ConformanceShortRep version \"1.0.0\" {\n  ## One to three letters, captured.\n  short = 1*3(%x61-7A) as code\n\n  entry short: short\n\n  test short {\n    capture \"ab\" { code: \"ab\" }\n    capture \"abc\" { code: \"abc\" }\n    reject \"abcd\"\n    reject \"\"\n  }\n}\n","tokens":[{"type":"doc","value":"## Semantics: T3, C3, K1, V3, B3, A1, A2, M0","offset":0},{"type":"newline","value":"\n","offset":44},{"type":"ident","value":"grammar","offset":45},{"type":"ident","value":"ConformanceShortRep","offset":53},{"type":"ident","value":"version","offset":73},{"type":"str","value":"\"1.0.0\"","offset":81},{"type":"punct","value":"{","offset":89},{"type":"newline","value":"\n","offset":90},{"type":"doc","value":"## One to three letters, captured.","offset":93},{"type":"newline","value":"\n","offset":127},{"type":"ident","value":"short","offset":130},{"type":"punct","value":"=","offset":136},{"type":"num","value":"1","offset":138},{"type":"punct","value":"*","offset":139},{"type":"num","value":"3","offset":140},{"type":"punct","value":"(","offset":141},{"type":"hex","value":"61-7A","offset":142},{"type":"punct","value":")","offset":149},{"type":"ident","value":"as","offset":151},{"type":"ident","value":"code","offset":154},{"type":"newline","value":"\n","offset":158},{"type":"newline","value":"\n","offset":159},{"type":"ident","value":"entry","offset":162},{"type":"ident","value":"short","offset":168},{"type":"punct","value":":","offset":173},{"type":"ident","value":"short","offset":175},{"type":"newline","value":"\n","offset":180},{"type":"newline","value":"\n","offset":181},{"type":"ident","value":"test","offset":184},{"type":"ident","value":"short","offset":189},{"type":"punct","value":"{","offset":195},{"type":"newline","value":"\n","offset":196},{"type":"ident","value":"capture","offset":201},{"type":"str","value":"\"ab\"","offset":209},{"type":"punct","value":"{","offset":214},{"type":"ident","value