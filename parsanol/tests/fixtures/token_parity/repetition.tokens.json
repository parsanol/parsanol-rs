{"source":"## Semantics: T1, C3, C4, K1, V2, V3, B1, B3, A1, A2, M0\ngrammar ConformanceRepetition version \"1.0.0\" {\n  ## Exactly two letters, captured as one string.\n  pair = 2*2(%x61-7A) as code\n  ## An optional dash prefix, then the pair.\n  dashed = [ \"-\" as dash ] pair\n\n  entry dashed: dashed\n\n  test dashed {\n    accept \"-ab\"\n    capture \"-ab\" { dash: \"-\"\n      code: \"ab\" }\n    capture \"ab\" { code: \"ab\" }\n    reject \"-a\"\n    reject \"abc\"\n  }\n}\n","tokens":[{"type":"doc","value":"## Semantics: T1, C3, C4, K1, V2, V3, B1, B3, A1, A2, M0","offset":0},{"type":"newline","value":"\n","offset":56},{"type":"ident","value":"grammar","offset":57},{"type":"ident","value":"ConformanceRepetition","offset":65},{"type":"ident","value":"version","offset":87},{"type":"str","value":"\"1.0.0\"","offset":95},{"type":"punct","value":"{","offset":103},{"type":"newline","value":"\n","offset":104},{"type":"doc","value":"## Exactly two letters, captured as one string.","offset":107},{"type":"newline","value":"\n","offset":154},{"type":"ident","value":"pair","offset":157},{"type":"punct","value":"=","offset":162},{"type":"num","value":"2","offset":164},{"type":"punct","value":"*","offset":165},{"type":"num","value":"2","offset":166},{"type":"punct","value":"(","offset":167},{"type":"hex","value":"61-7A","offset":168},{"type":"punct","value":")","offset":175},{"type":"ident","value":"as","offset":177},{"type":"ident","value":"code","offset":180},{"type":"newline","value":"\n","offset":184},{"type":"doc","value":"## An optional dash prefix, then the pair.","offset":187},{"type":"newline","value":"\n","offset":229},{"type":"ident","value":"dashed","offset":232},{"type":"punct","value":"=","offset":239},{"type":"punct","value":"[","offset":241},{"type":"str","value":"\"-\"","offset":243},{"type":"ident","value":"as","offset":247},{"type":"ident","value":"dash","offset":250},{"type":"punct","value":"]","offset":255},{"type":"ident","value":"pair","offset":2